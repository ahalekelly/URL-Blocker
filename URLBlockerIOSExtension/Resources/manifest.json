{
  "manifest_version": 3,
  "name": "URL Blocker",
  "description": "Block Safari websites and SPA routes from a private local blocklist.",
  "version": "1.0",
  "permissions": [
    "scripting",
    "storage",
    "tabs"
  ],
  "optional_host_permissions": [
    "*://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "URL Blocker",
    "default_icon": {
      "48": "icons/icon-48.png",
      "96": "icons/icon-96.png",
      "128": "icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
